# Local runtime/configuration
.env
*.local.*
**/.venv/
**/__pycache__/
**/cdp-profile/
**/*.DS_Store
*.log
.omx/

# Data policy: ignore runtime, binary, credential-bearing, regenerated, and bulky artifacts by default.
data/*
!data/
!data/claude_*.json
!data/chatgpt_*.json
!data/gemini_*.json
!data/locale_diff_report.json

