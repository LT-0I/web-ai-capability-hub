@inproceedings{620393,
  author = "Beckwith, J. F.",
  title = "Relating Brake Drum Weight to Brake Drum Life",
  booktitle = "Pre-1964 SAE Technical Papers",
  publisher = "SAE International",
  month = jan,
  year = 1962,
  doi = "https://doi.org/10.4271/620393",
  url = "https://doi.org/10.4271/620393",
  issn = "0148-7191",
  abstract = "This paper discusses a laboratory test evaluation of brake drum weight to brake drum life and describes test procedures used to measure the life of 16-1/2 in. × 7 in. brake drums. There is a direct relation of brake drum weight to brake drum life on any given application. The weight increase in brake drums to increase life has to be applied over the braking surface of the drum. The test results and procedures are covered."
}
