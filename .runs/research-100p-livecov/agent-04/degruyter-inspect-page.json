inline-start: 6px;\n    padding-inline-end: 6px;\n}\n\n.amzn-captcha-modal {\n    background-color: #fff,\n}\n\n/* TODO: Fix this so the root uses classes instead of an ID */\n#root select,\n#root button {\n    font-size: inherit;\n}\n\n/* Consistent keyboard focus styling */\n#root *:focus {\n    outline: 3px solid #0972d3;\n    outline-offset: 1px;\n}\n\n.amzn-captcha-state-container {\n    max-width: 100px;\n}\n\n#root-instructions {\n    max-width: 350px;\n}\n\n#verification-status {\n    max-width: 250px;\n}\n\ninput[type=\"checkbox\"] {\n    display: none;\n}\n\ninput[type=\"checkbox\"]:checked ~ label > img {\n    transform: scale(2);\n    background: rgb(255, 255, 255);\n    box-shadow: 1px 2px 2px rgb(117, 117, 117), -1px 2px 2px rgb(117, 117, 117);\n    cursor: zoom-out;\n}\n\ninput[type=\"text\"],\nselect,\n.btn {\n    font-family: 'Amazon Ember', Helvetica, Arial, sans-serif;\n    font-size: inherit;\n}\n\n.element img {\n    transition: transform 0.25s ease;\n    cursor: zoom-in;\n}\n\n.grid-category {\n    text-decoration: underline;\n    font-family: 'Amazon Ember', Helvetica, Arial, sans-serif;\n    font-weight:'heavy';\n}\n\n.amzn-captcha-lang-selector {\n    border: 1px solid #ccc;\n    border-radius: 4px;\n    background: transparent;\n}\n\n.amzn-captcha-audio-play-btn {\n    display: flex;\n    margin: 0 auto;\n    align-items: center;\n    background-color: #18817E;\n    border: 1px solid #18817E;\n}\n\n.amzn-grid-focus {\n    position: absolute;\n    background: transparent;\n    outline: 3px solid #0972d3;\n    outline-offset: 1px;\n    pointer-events: none;\n}\n</style><link rel=\"stylesheet\" href=\"https://static.captcha.awswaf.com/fonts/AmazonEmberLt/stylesheet.css\"></head>\n<body>\n    <div id=\"captcha-container\" dir=\"ltr\" style=\"width: 320px; margin: 0px auto;\"><div id=\"root\" style=\"font-family: &quot;Amazon Ember&quot;, Helvetica, Arial, sans-serif; width: 100%;\"><div style=\"padding: 50px 0px; text-align: center; border-top: 1px solid rgb(204, 204, 204); border-bottom: 1px solid rgb(204, 204, 204); margin: 0px auto; max-width: 500px; width: 100%;\"><div style=\"display: none; background-color: rgb(255, 233, 228); padding: 5px 20px; margin-bottom: 20px; font-size: 0.875em;\"><img src=\"data:image/svg+xml;base64,\"><p style=\"margin-left: 10px;\">临时错误。请再试一次。</p></div><div style=\"display: none; background-color: rgb(255, 233, 228); padding: 5px 20px; margin-bottom: 20px; font-size: 0.875em;\"><img src=\"data:image/svg+xml;base64,\"><p style=\"margin-left: 10px;\">在继续处理您的请求之前，您需要完成拼图，并且该拼图要求禁用 Google Translate。请禁用 Google Translate 并重试。</p></div><div><h1 style=\"font-weight: normal; color: rgb(221, 107, 16);\">我们需要确认您是人类</h1></div><div style=\"display: flex; flex-direction: column; margin-top: 10px;\"><div id=\"root-instructions\" style=\"text-align: initial; align-self: center; line-height: 22px;\"><p>在继续操作之前，请完成安全检查。此步骤将验证您不是机器人，这有助于保护您的账户并阻止垃圾邮件。</p></div><div id=\"verification-status\" style=\"display: flex; flex-direction: row; justify-content: space-between; align-items: center; align-self: center; margin-top: 20px;\"><div class=\"amzn-captcha-state-container\" style=\"align-self: center;\"><button class=\"amzn-captcha-verify-button btn btn-primary\" id=\"amzn-captcha-verify-button\" type=\"button\" style=\"display: flex; padding: 5px 30px;\">开始<img src=\"data:image/svg+xml;base64,\" alt=\"begin\" style=\"margin-left: 5px;\"></button></div></div></div></div><select class=\"amzn-captcha-lang-selector\" aria-label=\"Select language\" style=\"margin-top: 5px;\"><option value=\"ar\" aria-labelledby=\"ar\">العربية</option><option value=\"cs\" aria-labelledby=\"cs\">Čeština</option><option value=\"da\" aria-labelledby=\"da\">Dansk</option><option value=\"de\" aria-labelledby=\"de\">Deutsch</option><option value=\"en\" aria-labelledby=\"en\">English</option><option value=\"es\" aria-labelledby=\"es\">Español</option><option value=\"fr\" aria-labelledby=\"fr\">Français</option><option value=