        "command": [
          "node",
          "dist/src/cli.js",
          "browser:tab:alloc",
          "--profile",
          "gemini-9225",
          "--url",
          "${gem_url}",
          "--tab-id",
          "gemini-gems-converse",
          "--json"
        ]
      },
      {
        "id": "send-gem-prompt",
        "name": "Send a prompt through the Gemini Gem URL",
        "use_capability": "gemini-gems-converse-mgr",
        "confirmed": true,
        "input": {
          "url": "${gem_url}",
          "prompt": "${prompt}",
          "reuse_conversation": true,
          "response_timeout_ms": 90000
        },
        "command": [
          "node",
          "dist/src/cli.js",
          "webai:gemini:send-prompt",
          "--profile",
          "gemini-9225",
          "--url",
          "${gem_url}",
          "--reuse-conversation",
          "--prompt",
          "${prompt}",
          "--response-timeout-ms",
          "90000",
          "--json"
        ]
      },
      {
        "id": "verify-gem-gate",
        "action": "read",
        "input": {
          "gate": "response_text non-empty AND chat_url contains /gem/"
        }
      }
    ],
