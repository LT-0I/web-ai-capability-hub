    "description": "Open a Gemini Gem URL and send a prompt on the Gem conversation surface via managed CDP.",
    "conversation": {
      "reuse_conversation": true,
      "url": "https://gemini.google.com/gem/coding-partner"
    },
    "inputs": {
      "gem_url": "https://gemini.google.com/gem/coding-partner",
      "prompt": "Say only OK",
      "response_timeout_ms": 90000
    },
    "steps": [
